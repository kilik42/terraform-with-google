# ==========================================
# Terraform .gitignore
# ==========================================

# Terraform working directory
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files
# These may contain passwords, secrets, keys, etc.
*.tfvars
*.tfvars.json

# Keep example variable files
!*.tfvars.example
!terraform.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan
tfplan
plan.out

# Lock info files
.terraform.tfstate.lock.info

# ==========================================
# Secrets / Environment Variables
# ==========================================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

# ==========================================
# Python
# ==========================================

__pycache__/
*.py[cod]
*.pyo
*.pyd

.venv/
venv/
env/

# ==========================================
# IDE / Editor
# ==========================================

.vscode/
.idea/

# ==========================================
# Operating System
# ==========================================

.DS_Store
Thumbs.db

# ==========================================
# Build / Temporary Files
# ==========================================

build/
dist/
tmp/
temp/
*.zip